# Copy to .env for local development. Never commit .env.
# In Azure these are App Service "Application settings".

# --- Entra / Microsoft Graph ---
TENANT_ID=00000000-0000-0000-0000-000000000000
# App registration client ID (only used together with CLIENT_SECRET).
CLIENT_ID=00000000-0000-0000-0000-000000000000
# Leave empty to use the Web App's system-assigned managed identity (recommended in Azure).
CLIENT_SECRET=
# Optional: client ID of a *user-assigned* managed identity. Leave empty for system-assigned.
MANAGED_IDENTITY_CLIENT_ID=
# Object ID of the cohort security group.
GROUP_ID=00000000-0000-0000-0000-000000000000

# --- Cohort gate ---
ACCESS_CODE=change-me
# Defaults to https://portal.azure.com/<TENANT_ID> when empty.
INVITE_REDIRECT_URL=
INVITE_MESSAGE=Welcome to the AI training cohort!
# Max successful invitations per UTC day (0 = unlimited).
DAILY_INVITE_CAP=100
# Per-IP limit for POST /api/register (Flask-Limiter syntax).
REGISTER_RATE_LIMIT=5 per 10 minutes

# --- Cloudflare Turnstile ---
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Submission log (Azure Table Storage) ---
# Leave empty locally to use an in-memory store (data lost on restart).
STORAGE_CONNECTION_STRING=
TABLE_NAME=submissions

# --- Admin page (/admin) ---
# Comma-separated UPNs and/or an Entra group object ID (needs groups claim in Easy Auth).
ADMIN_UPNS=
ADMIN_GROUP_ID=
# LOCAL DEV ONLY: bypass Easy Auth on /admin. Never set in Azure.
LOCAL_DEV_ADMIN=false
